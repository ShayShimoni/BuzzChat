<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?colorSurface">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/sivProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:elevation="2dp"
        android:src="@drawable/ic_profile_round_place_holder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvName"
        style="?textAppearanceTitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Name"
        android:textColor="?colorOnSurface"
        app:layout_constraintStart_toEndOf="@+id/sivProfile"
        app:layout_constraintTop_toTopOf="@+id/sivProfile" />

    <TextView
        android:id="@+id/tvLastMsg"
        style="?textAppearanceBodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Last message"
        android:textColor="?colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@+id/sivProfile"
        app:layout_constraintStart_toEndOf="@+id/sivProfile" />

    <TextView
        android:id="@+id/tvLastMsgTime"
        style="?textAppearanceBodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="08:00"
        android:textColor="?colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvName" />

    <TextView
        android:id="@+id/tvNumberBadge"
        style="?textAppearanceBodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:text="3"
        android:textColor="?colorOnTertiary"
        app:layout_constraintBottom_toBottomOf="@+id/tvLastMsg"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>